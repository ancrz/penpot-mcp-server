# ═══════════════════════════════════════════════════════════
# Penpot MCP Server — Local Development Configuration
# ═══════════════════════════════════════════════════════════
# Template for running `uv run penpot-mcp` locally on the host while
# Penpot runs in Docker with host-mapped ports.
# Recreate local .env with:
#   cp .env.local.example .env
# Then fill in PENPOT_ACCESS_TOKEN (or PENPOT_EMAIL/PENPOT_PASSWORD) and PENPOT_DB_PASS.
# Do NOT commit .env to version control.

# ── Version & Upgrade Management (Build / Runtime) ────────
PENPOT_MCP_VERSION=0.3.0
PYTHON_IMAGE_TAG=3.13-alpine
UV_VERSION=0.12.10
MCP_PROTOCOL_VERSION=2025-03-26
MCP_TOOL_MODE=compressed

# ── Penpot Connection (host-mapped) & SSRF Guard ──────────
PENPOT_BASE_URL=http://localhost:9001
PENPOT_PUBLIC_URL=http://localhost:9001
SSRF_ALLOW_PRIVATE_MEDIA=false

# ── Authentication ────────────────────────────────────────
# Token (recommended) and/or email+password (also used by exporter cookie auth)
PENPOT_ACCESS_TOKEN=
PENPOT_EMAIL=
PENPOT_PASSWORD=

# ── PostgreSQL (host-mapped port from Penpot compose) ─────
# Default 'penpot' for local dev compatibility; use 'penpot_mcp' if read-only role is provisioned
PENPOT_DB_HOST=127.0.0.1
PENPOT_DB_PORT=5433
PENPOT_DB_NAME=penpot
PENPOT_DB_USER=penpot
PENPOT_DB_PASS=
DB_STATEMENT_TIMEOUT_MS=30000

# ── MCP Server & Host Protection ──────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8787
MCP_LOG_LEVEL=info
MCP_ALLOWED_HOSTS=["127.0.0.1","localhost","penpot-mcp"]

# ── WebSocket / Plugin channel (opt-in) ───────────────────
WS_ENABLED=false
WS_HOST=127.0.0.1
WS_PORT=4402
WS_TOKEN=
PLUGIN_WS_URL=ws://localhost:4402
PLUGIN_ORIGIN=http://localhost:8787
