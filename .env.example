# ═══════════════════════════════════════════════════════════
# Penpot MCP Server — Configuration (Docker Default)
# ═══════════════════════════════════════════════════════════
# Copy this file to .env for Docker deployment, or copy .env.local.example
# to .env when running `penpot-mcp` locally outside Docker.
# Do NOT commit .env to version control (covered by .gitignore).

# ── Version & Upgrade Management (Build / Runtime) ────────
PENPOT_MCP_VERSION=0.3.0
PYTHON_IMAGE_TAG=3.13-alpine
UV_VERSION=0.12.10
MCP_PROTOCOL_VERSION=2025-03-26
# Tool exposure mode: "compressed" (14 AEP-style polymorphic sub-tools),
# "legacy" (77 individual tools), or "hybrid" (both).
MCP_TOOL_MODE=compressed

# ── Penpot Connection & SSRF Guard ────────────────────────
# Internal URL (Docker network). Local dev outside Docker: http://localhost:9001
PENPOT_BASE_URL=http://penpot-frontend:8080

# Public URL where you access Penpot in the browser
PENPOT_PUBLIC_URL=http://localhost:9001

# Strict SSRF guard for upload_media URLs (keep false in production)
SSRF_ALLOW_PRIVATE_MEDIA=false

# ── Authentication (use one or both) ──────────────────────
# Method 1: Access Token (recommended — requires enable-access-tokens flag in Penpot)
# Generate at: Penpot → Avatar → Access Tokens → Generate new token
PENPOT_ACCESS_TOKEN=

# Method 2: Email/Password (fallback if no access token; also required by /api/export)
PENPOT_EMAIL=
PENPOT_PASSWORD=

# ── PostgreSQL ────────────────────────────────────────────
# Default 'penpot' preserves backward compatibility with standard Penpot compose stacks.
# For hardened production deployments, create the read-only role and set PENPOT_DB_USER=penpot_mcp.
PENPOT_DB_HOST=penpot-postgres
PENPOT_DB_PORT=5432
PENPOT_DB_NAME=penpot
PENPOT_DB_USER=penpot
PENPOT_DB_PASS=
DB_STATEMENT_TIMEOUT_MS=30000

# ── MCP Server & Host Protection ──────────────────────────
# Inside Docker bind 0.0.0.0 (publish on 127.0.0.1:8787); for local-only dev prefer 127.0.0.1
MCP_HOST=0.0.0.0
MCP_PORT=8787
MCP_LOG_LEVEL=info
MCP_ALLOWED_HOSTS=["127.0.0.1","localhost","penpot-mcp"]

# ── WebSocket / Plugin channel (opt-in) ───────────────────
# Set WS_ENABLED=true and a strong random WS_TOKEN to enable the live canvas bridge
WS_ENABLED=false
WS_HOST=127.0.0.1
WS_PORT=4402
WS_TOKEN=
PLUGIN_WS_URL=ws://localhost:4402
PLUGIN_ORIGIN=http://localhost:8787
